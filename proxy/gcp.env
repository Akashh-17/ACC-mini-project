# GCP region values for proxy/render.sh. AWS/Azure copy this and change
# REGION_ID and STANDARD_SERVICE (recommend-api / admin-api).
REGION_ID=gcp-asia-south1
PUBLIC_IP=${PUBLIC_IP:-}     # pass on the command line — kept out of the public repo
STANDARD_SERVICE=notify-api

AGENT_PORT=9000
PAYMENTS_PORT=8081
FRAUD_PORT=8082
INVENTORY_PORT=8083
STANDARD_PORT=8084

RATE_LIMIT=20r/s
RATE_BURST=40

PROXY_TLS_CERT=/etc/registry/proxy/proxy.crt
PROXY_TLS_KEY=/etc/registry/proxy/proxy.key
