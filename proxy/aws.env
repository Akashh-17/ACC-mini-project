# AWS values for the existing GCP-owned proxy/render.sh template.
REGION_ID=aws-ap-south-1
PUBLIC_IP=${PUBLIC_IP:-}
STANDARD_SERVICE=recommend-api

AGENT_PORT=9000
PAYMENTS_PORT=8081
FRAUD_PORT=8082
INVENTORY_PORT=8083
STANDARD_PORT=8084

RATE_LIMIT=20r/s
RATE_BURST=40
PROXY_TLS_CERT=/etc/registry/proxy/proxy.crt
PROXY_TLS_KEY=/etc/registry/proxy/proxy.key
