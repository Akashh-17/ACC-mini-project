# Copy to /etc/registry/replicator.env, chmod 600 (root only), fill in. Never commit the real file.
# KAFKA_API_KEY/SECRET: this cloud's own Confluent API key (infra/kafka/README.md).
REGION_ID=gcp-asia-south1
LEDGER_PATH=/var/lib/registry/ledger.db
KAFKA_BOOTSTRAP=pkc-XXXXX.asia-south1.gcp.confluent.cloud:9092
KAFKA_API_KEY=change-me
KAFKA_API_SECRET=change-me
