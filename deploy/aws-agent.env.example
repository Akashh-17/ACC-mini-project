# AWS example for the existing systemd unit. Replace placeholders privately.
REGION_ID=aws-ap-south-1
REGISTRY_SECRET=change-me
REGISTRY_PORT=9000
REGISTRY_ALLOW_LOOPBACK=false
REPLICATION_PEERS=azure-indiasouthcentral=https://AZURE_STATIC_IP:9443,gcp-asia-south1=https://GCP_STATIC_IP:9443
REPLICATION_PORT=9443
TLS_CERT=/etc/registry/tls/aws-ap-south-1.crt
TLS_KEY=/etc/registry/tls/aws-ap-south-1.key
TLS_CA=/etc/registry/tls/ca.crt
