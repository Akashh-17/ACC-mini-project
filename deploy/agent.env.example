# Copy to /etc/registry/agent.env (chmod 600) and fill in. Never commit the real file.
REGION_ID=gcp-asia-south1
REGISTRY_SECRET=change-me
REPLICATION_PEERS=aws-ap-south-1=https://AWS_STATIC_IP:9443,azure-indiasouthcentral=https://AZURE_STATIC_IP:9443
REPLICATION_PORT=9443
TLS_CERT=/etc/registry/tls/gcp-asia-south1.crt
TLS_KEY=/etc/registry/tls/gcp-asia-south1.key
TLS_CA=/etc/registry/tls/ca.crt
